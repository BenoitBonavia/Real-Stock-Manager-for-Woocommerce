<?xml version="1.0"?>
<ruleset name="Real Stock Manager for WooCommerce">
	<description>Règles de codage WordPress appliquées au plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- Le plugin utilise des namespaces PSR-4 plutôt que class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="real-stock-manager-for-woocommerce"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="rsmw,RSMW"/>
		</properties>
	</rule>
</ruleset>
